# ══════════════════════════════════════════════════════════════════════════════
# AXIOM Environment Configuration
# Copy to .env and fill in your values
# ══════════════════════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=AXIOM
DEBUG=false
LOG_LEVEL=INFO

# ── Supabase (PostgreSQL + pgvector) ──────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
DATABASE_URL=postgresql+asyncpg://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# ── OpenAI (embeddings) ───────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── DeepSeek V3 (skill synthesis) ─────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ── Capability Resolver ────────────────────────────────────────────────────────
RESOLVER_TOP_K=10
RESOLVER_SEMANTIC_WEIGHT=0.6
RESOLVER_SUCCESS_WEIGHT=0.3
RESOLVER_RECENCY_WEIGHT=0.1
RESOLVER_CONFIDENCE_THRESHOLD=0.45

# ── Synthesis ──────────────────────────────────────────────────────────────────
SYNTHESIS_TEMPERATURE=0.2
SYNTHESIS_MAX_TOKENS=4096
SYNTHESIS_FEW_SHOT_K=3
DEDUP_COSINE_THRESHOLD=0.92

# ── Sandbox ────────────────────────────────────────────────────────────────────
SANDBOX_MEMORY_LIMIT_MB=256
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_ALLOW_NETWORK=false
PROMOTION_MIN_SUCCESS_RATE=0.8
PROMOTION_MIN_TEST_CASES=3

# ── Decay Monitor ──────────────────────────────────────────────────────────────
DECAY_MIN_INVOCATIONS=50
DECAY_SUCCESS_THRESHOLD=0.70
DECAY_IDLE_DAYS=30
DECAY_CHECK_INTERVAL_MINUTES=60

# ── Hermes Integration ─────────────────────────────────────────────────────────
HERMES_SKILL_DIR=./skills
HERMES_AUTO_INGEST=true
